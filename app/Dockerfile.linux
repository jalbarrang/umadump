# Builds the Linux bundle in a container, so a Windows or macOS host can produce
# it without a Linux machine. Used by: python app/build.py --docker
#
# Base choice is deliberate:
#   * PyInstaller needs a Python built with a shared libpython. The manylinux
#     wheels for 3.14 are built without one, and python:3.14-slim-bookworm
#     (glibc 2.36) would push the floor to 2.36 and lock out Ubuntu 22.04 LTS.
#   * Ubuntu 22.04 (glibc 2.35) + deadsnakes python3.14 is the lowest base that
#     satisfies both, so the produced binary runs on Ubuntu 22.04+ (and
#     Debian 12+, Fedora, RHEL 9+).
# No GUI dependency raises the floor: Dear PyGui statically links its SDL2 into
# _dearpygui.so and is manylinux-compatible.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1

# binutils/patchelf/file: PyInstaller ELF dependency analysis.
# libx11-6: Dear PyGui's _dearpygui.so links it directly (SDL2 is statically
# linked in), so it must be present for the smoke test to import at all.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      software-properties-common \
      ca-certificates \
      gnupg \
      dirmngr \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.14 \
      python3.14-dev \
      python3.14-venv \
      binutils \
      patchelf \
      file \
      libx11-6 \
 && rm -rf /var/lib/apt/lists/*

# A venv avoids Ubuntu's externally-managed marker for the system interpreter.
RUN python3.14 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv

WORKDIR /src

# requirements-build.txt references requirements.txt, so both must sit together.
COPY app/requirements.txt app/requirements-build.txt /tmp/
RUN python -m pip install --upgrade pip \
 && python -m pip install -r /tmp/requirements-build.txt
